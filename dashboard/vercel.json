{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "develop": false
    }
  },
  "ignoreCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" = \"develop\" ]; then exit 0; else exit 1; fi",
  "crons": [
    {
      "path": "/api/cron/daily-rollup",
      "schedule": "0 0 * * *"
    }
  ]
}
